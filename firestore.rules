
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      let isHardcodedAdmin = request.auth.token.email == 'gnavneet444@gmail.com';
      let hasAdminRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      return isHardcodedAdmin || hasAdminRole;
    }

    // Users can read their own profile, admins can read any profile.
    // Users can create their own profile.
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow list: if isAdmin();
    }

    // Users can read, write, and delete items in their own cart.
    match /users/{userId}/cart/{cartItemId} {
      allow read, write, delete: if request.auth.uid == userId;
    }

    // Products are publicly readable.
    // Only admins can create, update, or delete products.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Allow admins to upload images to the 'products' folder
    match /products/{allPaths=**} {
      allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' || request.auth.token.email == 'gnavneet444@gmail.com';
    }

    // Allow anyone to read images
    match /{allPaths=**} {
      allow read: if true;
    }
  }
}
